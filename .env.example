# PostgreSQL connection string the app uses, locally and in docker-compose. Works
# with any Postgres-compatible provider. For Supabase use the "Transaction
# pooler" URI (Connect -> Transaction pooler, port 6543) with your database
# password filled in: it lets many copies of the app share the project's small
# connection limit. Do NOT add `?sslmode=...` (the app turns SSL on by itself).
DATABASE_URL=

# Only for migrations (`prisma migrate deploy`), which need a real session:
# Supabase's "Session pooler" URI (port 5432). Leave empty to run migrations
# against DATABASE_URL instead (plain Postgres).
DIRECT_URL=

# Signs the login cookies — 32+ random characters, kept secret. Generate one with:
#   npm run user -- secret
# Changing it signs everyone out.
AUTH_SECRET=

# Only used by the optional bundled Postgres (`docker compose --profile local-db`,
# with DATABASE_URL=postgresql://<user>:<password>@db:5432/<db>). Irrelevant with Supabase.
# Change POSTGRES_PASSWORD before deploying anywhere but your own machine.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydb

# The team's SHARED scrape.do key. Used by lib/scrapeDo.ts for every outbound fetch
# (Amazon product/search pages, Google search result pages, brand websites) of
# anyone who hasn't saved their own key on the Settings page. May be left empty
# when everybody adds their own (see REQUIRE_OWN_API_KEYS below).
SCRAPE_DO_API_KEY=

# Optional. Encrypts the API keys people save on the Settings page. Leave empty
# to derive it from AUTH_SECRET. Every deployment that shares the database must
# use the same value (a key saved on one can't be read by another otherwise), and
# changing it makes saved keys unreadable — people would have to enter them again.
API_KEY_SECRET=

# Optional. Set to 1 so members must add their own keys before they can start a
# search or lookup, instead of falling back to the shared keys above. The admin
# can always use the shared keys.
REQUIRE_OWN_API_KEYS=

# Optional. Used by lib/enrichment/emailProviders/hunter.ts if/when it's wired up
# as an alternative to the regex-based extractor. Safe to leave empty for now.
HUNTER_API_KEY=

# Optional fallback for brand website discovery via the Google Custom Search JSON
# API instead of scraping Google search results through scrape.do. Leave both
# empty to keep using scrape.do for the Google search step.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# The team's SHARED SearchAPI.io key, used by lib/searchApi.ts for the Meta Ad
# Library search (the "Ad Library" page/tab) by anyone without their own key —
# https://www.searchapi.io/
SEARCHAPI_API_KEY=
