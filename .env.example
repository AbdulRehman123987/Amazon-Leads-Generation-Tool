# PostgreSQL connection string used by Prisma, both locally and in docker-compose.
# Works with any Postgres-compatible provider. For Supabase use the "Session
# pooler" URI (Connect -> Session pooler, port 5432) with your database password
# filled in — and do NOT add `?sslmode=...` (the app turns SSL on by itself).
DATABASE_URL=

# Only used by the optional bundled Postgres (`docker compose --profile local-db`,
# with DATABASE_URL=postgresql://<user>:<password>@db:5432/<db>). Irrelevant with Supabase.
# Change POSTGRES_PASSWORD before deploying anywhere but your own machine.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydb

# scrape.do API key. Used by lib/scrapeDo.ts for every outbound fetch (Amazon
# product/search pages, Google search result pages, brand websites).
SCRAPE_DO_API_KEY=

# Optional. Used by lib/enrichment/emailProviders/hunter.ts if/when it's wired up
# as an alternative to the regex-based extractor. Safe to leave empty for now.
HUNTER_API_KEY=

# Optional fallback for brand website discovery via the Google Custom Search JSON
# API instead of scraping Google search results through scrape.do. Leave both
# empty to keep using scrape.do for the Google search step.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# SearchAPI.io key, used by lib/searchApi.ts for the Meta Ad Library search
# (the "Ad Library" page/tab) — https://www.searchapi.io/
SEARCHAPI_API_KEY=
