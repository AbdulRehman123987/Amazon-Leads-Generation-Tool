// Prisma schema for the Amazon lead-generation scraper.
// Provider defaults to postgresql; swapping to a hosted Postgres (Supabase/Neon)
// only requires changing DATABASE_URL, not this file.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScrapeJobType {
  AMAZON_SEARCH
  BRAND_ENRICHMENT
  META_ADS_SEARCH
  META_ADS_ENRICHMENT
}

enum ScrapeJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED // stopped by the person who started it (or an admin)
}

// ADMIN sees and can manage every user's data; MEMBER only their own.
enum UserRole {
  MEMBER
  ADMIN
}

enum BrandEnrichmentStatus {
  NOT_STARTED
  IN_PROGRESS
  FOUND
  PARTIAL
  NOT_FOUND
}

// Team members who can sign in. There is no sign-up form: an admin creates
// accounts with `npm run user -- create <email>` (see scripts/users.mjs).
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stored trimmed and lowercased.
  email String @unique

  // scrypt hash (see lib/auth/password.ts) — never the password itself.
  passwordHash String

  role UserRole @default(MEMBER)

  // Everything a user scrapes belongs to them. Deleting the account keeps the
  // data (userId becomes null) — then only an admin can see it.
  jobs         ScrapeJob[]
  products     Product[]
  brands       Brand[]
  metaAdBrands MetaAdBrand[]
}

model ScrapeJob {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  type      ScrapeJobType
  status    ScrapeJobStatus @default(PENDING)

  // Search keyword / category URL / filters the job was started with.
  input Json

  // 0-100 percentage, derived from processedItems/totalItems.
  progress       Int @default(0)
  totalItems     Int @default(0)
  processedItems Int @default(0)
  errorCount     Int @default(0)

  // Array of { timestamp, message, level } objects, appended to as the job runs.
  logs Json @default("[]")

  products     Product[]
  metaAdBrands MetaAdBrand[]

  // Who started it. Products, brands and ad-library results it creates get the
  // same owner (see lib/auth/access.ts).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
}

// Which Amazon site a product was scraped from (see lib/amazon/marketplaces.ts).
enum AmazonMarketplace {
  US // amazon.com
  UK // amazon.co.uk
}

model Product {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asin String

  // The same ASIN is often sold on several Amazon sites with different prices,
  // ranks and reviews, so an ASIN is only unique within one marketplace.
  marketplace AmazonMarketplace @default(US)

  title       String
  url         String
  imageUrl    String?
  price       Float?
  currency    String?
  reviewCount Int?
  rating      Float?
  bsr         Int?
  category    String?

  // Brand string as scraped from the Amazon page, before matching to a Brand row.
  brandNameRaw String?

  // Computed low-sale-volume score in [0, 1]; see lib/scoring.ts for the formula.
  lowSaleScore Float?

  scrapeJob   ScrapeJob @relation(fields: [scrapeJobId], references: [id])
  scrapeJobId String

  brand   Brand?  @relation(fields: [brandId], references: [id])
  brandId String?

  // Each user has their own copy of a product, so two people scraping the same
  // keyword don't overwrite each other's results.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, asin, marketplace])
  @@index([userId])
  @@index([marketplace])
  @@index([brandId])
  @@index([scrapeJobId])
  @@index([lowSaleScore])
  @@index([reviewCount])
  @@index([bsr])
}

model Brand {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Normalized (trimmed, lowercased) name used as the dedup/matching key —
  // unique per user, so everyone has their own brand list with their own
  // enrichment results, manual edits and export history.
  name String

  // Original casing as scraped, for display.
  displayName String

  websiteUrl        String?
  websiteConfidence Float?
  email             String?
  phone             String?
  contactPageUrl    String?

  enrichmentStatus BrandEnrichmentStatus @default(NOT_STARTED)

  // Free-text scratchpad: search query used, candidate URLs considered, etc.
  rawNotes String?

  // Set when the brand last went out in a CSV export, so the next export can
  // skip it. Null = never exported.
  exportedAt DateTime?

  products Product[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, name])
  @@index([userId])
  @@index([enrichmentStatus])
}

// A Facebook/Instagram Page found running ads for a searched product/keyword
// via the Meta Ad Library (through SearchAPI.io) — a separate lead-discovery
// funnel from the Amazon->Brand one above, not merged with Brand since the
// identity keys differ (Meta page vs. Amazon byline brand name) and a page
// found here isn't necessarily the same entity as an existing Brand row.
model MetaAdBrand {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pageId             String
  pageName           String
  pageProfileUri     String?
  pageProfilePicture String?
  pageLikeCount      Int?
  pageCategory       String?

  // The product/keyword this was found under, and how many currently-active
  // ads matched it — re-searching the same keyword updates this row rather
  // than duplicating it, since ad counts are a live snapshot, not history.
  searchKeyword   String
  activeAdCount   Int
  sampleAdSnippet String?

  // Contact enrichment — same fields/semantics as Brand, found via the same
  // lib/enrichment/findContactInfo.ts pipeline (website discovery + email/
  // phone extraction), just keyed off the Page name instead of an Amazon
  // byline brand name.
  websiteUrl        String?
  websiteConfidence Float?
  email             String?
  phone             String?
  contactPageUrl    String?
  enrichmentStatus  BrandEnrichmentStatus @default(NOT_STARTED)
  rawNotes          String?

  scrapeJob   ScrapeJob @relation(fields: [scrapeJobId], references: [id])
  scrapeJobId String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, pageId, searchKeyword])
  @@index([userId])
  @@index([activeAdCount])
  @@index([searchKeyword])
  @@index([enrichmentStatus])
}
